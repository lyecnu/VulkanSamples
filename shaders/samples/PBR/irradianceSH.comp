#version 450

layout (local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) uniform samplerCube environmentMap;
layout (binding = 1) buffer SHCoeffs
{
    vec4 coeffs[9];
};

#define SAMPLES_PER_THREAD 256
#define TOTAL_SAMPLES 65536 // 256 * 256
#define PI 3.14159265359
#define GOLDEN_RATIO 1.618033988749895

shared vec4 sharedCoeffs[9][256];

float SHbasis(int l, int m, vec3 dir) {
    float x = dir.x, y = dir.y, z = dir.z;
    if (l == 0) return 0.282094792;          // Y00
    if (l == 1) {
        if (m == -1) return 0.488602512  * y; // Y1-1
        if (m ==  0) return 0.488602512  * z; // Y10
        if (m ==  1) return 0.488602512  * x; // Y11
    }
    if (l == 2) {
        if (m == -2) return 1.092548431  * x * y;           // Y2-2
        if (m == -1) return 1.092548431  * y * z;           // Y2-1
        if (m ==  0) return 0.315391565 * (3.0*z*z - 1.0);  // Y20
        if (m ==  1) return 1.092548431  * x * z;           // Y21
        if (m ==  2) return 0.546274215  * (x*x - y*y);     // Y22
    }
    return 0.0;
}

float SHbasisFlat(int index, vec3 dir)
{
    if (index == 0) return SHbasis(0, 0, dir);
    if (index <= 3) return SHbasis(1, index - 2, dir);
    return SHbasis(2, index - 6, dir);
}

void main()
{
    uint threadIdx = gl_LocalInvocationID.x;

    for (int i = 0; i < 9; i++)
    {
        sharedCoeffs[i][threadIdx] = vec4(0.0);
    }

    for (uint s = 0; s < SAMPLES_PER_THREAD; s++)
    {
        uint globalIdx = threadIdx * SAMPLES_PER_THREAD + s;

        // Fibonacci sphere sampling for uniform distribution
        float cosTheta = 1.0 - (2.0 * float(globalIdx) + 1.0) / float(TOTAL_SAMPLES);
        float sinTheta = sqrt(1.0 - cosTheta * cosTheta);
        float phi = 2.0 * PI * fract(float(globalIdx) * GOLDEN_RATIO);

        vec3 dir = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);

        vec3 radiance = texture(environmentMap, dir).rgb;

        // Project onto SH basis functions and accumulate
        for (int i = 0; i < 9; i++)
        {
            sharedCoeffs[i][threadIdx].xyz += radiance * SHbasisFlat(i, dir);
        }
    }

    barrier();

    // Parallel reduction
    for (uint stride = 128; stride > 0; stride >>= 1)
    {
        if (threadIdx < stride)
        {
            for (int i = 0; i < 9; i++)
            {
                sharedCoeffs[i][threadIdx].xyz += sharedCoeffs[i][threadIdx + stride].xyz;
            }
        }
        barrier();
    }

    // Final result
    if (threadIdx == 0)
    {
        float weight = 4.0 * PI / float(TOTAL_SAMPLES);
        for (int i = 0; i < 9; i++)
        {
            coeffs[i] = vec4(sharedCoeffs[i][0].xyz * weight, 0.0);
        }
    }
}
